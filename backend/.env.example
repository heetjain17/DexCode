PORT = 8080
JWT_SECRET =

ACCESS_TOKEN_SECRET =
ACCESS_TOKEN_EXPIRY = '2h'

REFRESH_TOKEN_SECRET =
REFRESH_TOKEN_EXPIRY = '7d'

DATABASE_URL =
BASE_URL = "http://localhost:8080"
CLIENT_URL = "http://localhost:5173"

NODE_ENV=development

# Beta Mode — set to 'true' to disable registration (only pre-assigned credentials work)
BETA_MODE=

# Docker Compose — used to build DATABASE_URL inside the container
# Set these when running with docker-compose; DATABASE_URL is auto-constructed from them
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

MAIL_HOST = 
MAIL_PORT = 
MAIL_USERNAME = 
MAIL_PASSWORD = 

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=
RATE_LIMIT_STORE=
GLOBAL_RATE_LIMIT=
GLOBAL_RATE_WINDOW_MS=

# Auth Rate Limits (all optional, defaults are sensible for production)
AUTH_LOGIN_RATE_LIMIT=
AUTH_REGISTER_RATE_LIMIT=
AUTH_REFRESH_RATE_LIMIT=

# Judge0 API (RapidAPI)
JUDGE0_BASE_URL=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

# Judge0 Execution Tuning
JUDGE0_POLLING_INTERVAL_MS=
JUDGE0_MAX_POLLING_ATTEMPTS=

# Judge0 Rate Limiting
JUDGE0_RATE_LIMIT_PER_MINUTE=
JUDGE0_RATE_LIMIT_PER_DAY=
JUDGE0_MAX_CONCURRENT=