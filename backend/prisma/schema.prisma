generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  INTERNAL_ERROR
}

enum ProgrammingLanguage {
  JAVA
  PYTHON
  JAVASCRIPT
  CPP
}

enum TestCaseStatus {
  PASSED
  FAILED
  SKIPPED
  ERROR
}

// ============================================
// USER & PROFILE MODELS (UNCHANGED)
// ============================================

model User {
  id                      String    @id @default(uuid())
  image                   String?
  name                    String?
  email                   String    @unique
  role                    UserRole  @default(USER)
  password                String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  emailVerificationExpiry DateTime?
  emailVerificationToken  String?
  forgotPasswordExpiry    DateTime?
  forgotPasswordToken     String?
  isEmailVerified         Boolean   @default(false)
  refreshToken            String?
  provider                String    @default("CREDENTAILS")

  // Relations
  profile            Profile?
  playlists          Playlist[]
  problems           Problem[]
  submissions        Submission[]
  problemSolved      ProblemSolved[]
  discussions        Discussion[]
  discussionComments DiscussionComment[]
  discussionVotes    DiscussionVote[]
  commentVotes       CommentVote[]
  problemRatings     ProblemRating[]
}

model Profile {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId              String    @unique
  username            String    @unique
  displayName         String?
  avatarUrl           String?
  bio                 String?
  location            String?
  website             String?
  socialLinks         Json?
  problemsSolved      Int?      @default(0)
  easySolved          Int?      @default(0)
  mediumSolved        Int?      @default(0)
  hardSolved          Int?      @default(0)
  currentStreak       Int?      @default(0)
  longestStreak       Int?      @default(0)
  lastSolvedAt        DateTime? @db.Timestamp(6)
  totalSubmissions    Int?      @default(0)
  acceptedSubmissions Int?      @default(0)
  createdAt           DateTime? @default(now()) @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profile_user_fk")
}

// ============================================
// PROBLEM MODEL (ENHANCED)
// ============================================

model Problem {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  description String     @db.Text
  difficulty  Difficulty
  userId      String
  editorial   String?    @db.Text
  isPublished Boolean    @default(false)

  // Statistics
  totalSubmissions      Int      @default(0)
  successfulSubmissions Int      @default(0)
  acceptanceRate        Decimal? @db.Decimal(5, 2)
  likes                 Int      @default(0)
  dislikes              Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  testCases     TestCase[]
  codeTemplates CodeTemplate[]
  examples      Example[]
  constraints   Constraint[]
  hints         Hint[]
  tags          ProblemTag[]
  companies     ProblemCompany[]
  topics        ProblemTopic[]
  submissions   Submission[]
  solvedBy      ProblemSolved[]
  playlists     ProblemInPlaylist[]
  discussions   Discussion[]
  ratings       ProblemRating[]

  @@index([difficulty])
  @@index([userId])
  @@index([isPublished])
  @@index([createdAt])
}

// ============================================
// PROBLEM SUPPORTING MODELS
// ============================================

model TestCase {
  id        String   @id @default(uuid())
  problemId String
  input     String   @db.Text
  output    String   @db.Text
  isHidden  Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([problemId, order])
}

model CodeTemplate {
  id        String              @id @default(uuid())
  problemId String
  language  ProgrammingLanguage
  template  String              @db.Text
  userCode  String              @db.Text
  solution  String?             @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@index([problemId])
}

model Example {
  id          String   @id @default(uuid())
  problemId   String
  input       String   @db.Text
  output      String   @db.Text
  explanation String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([problemId, order])
}

model Constraint {
  id          String   @id @default(uuid())
  problemId   String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Hint {
  id        String   @id @default(uuid())
  problemId String
  content   String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

// ============================================
// TAG SYSTEM
// ============================================

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems ProblemTag[]

  @@index([slug])
}

model ProblemTag {
  id        String   @id @default(uuid())
  problemId String
  tagId     String
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([problemId, tagId])
  @@index([problemId])
  @@index([tagId])
}

// ============================================
// COMPANY SYSTEM
// ============================================

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems ProblemCompany[]

  @@index([slug])
}

model ProblemCompany {
  id        String   @id @default(uuid())
  problemId String
  companyId String
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([problemId, companyId])
  @@index([problemId])
  @@index([companyId])
}

// ============================================
// TOPIC SYSTEM
// ============================================

model Topic {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems ProblemTopic[]

  @@index([slug])
}

model ProblemTopic {
  id        String   @id @default(uuid())
  problemId String
  topicId   String
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([problemId, topicId])
  @@index([problemId])
  @@index([topicId])
}

// ============================================
// SUBMISSION MODELS (ENHANCED)
// ============================================

model Submission {
  id            String              @id @default(uuid())
  userId        String
  problemId     String
  code          String              @db.Text
  language      ProgrammingLanguage
  status        SubmissionStatus
  verdict       String?
  score         Decimal?            @db.Decimal(5, 2)
  executionTime Int?
  memoryUsed    Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  problem     Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  testResults TestCaseResult[]

  @@index([userId])
  @@index([problemId])
  @@index([status])
  @@index([userId, problemId])
}

model TestCaseResult {
  id            String         @id @default(uuid())
  submissionId  String
  testCaseId    String?
  testCase      Int
  status        TestCaseStatus
  passed        Boolean
  input         String?        @db.Text
  output        String?        @db.Text
  expected      String         @db.Text
  stderr        String?        @db.Text
  compileOutput String?        @db.Text
  executionTime Int?
  memoryUsed    Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ============================================
// PROBLEM SOLVED (ENHANCED)
// ============================================

model ProblemSolved {
  id               String   @id @default(uuid())
  userId           String
  problemId        String
  solvedAt         DateTime @default(now())
  attemptCount     Int      @default(1)
  bestSubmissionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

// ============================================
// PLAYLIST MODELS (ENHANCED)
// ============================================

model Playlist {
  id           String   @id @default(uuid())
  name         String
  slug         String
  description  String?  @db.Text
  userId       String
  isPublic     Boolean  @default(false)
  problemCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems ProblemInPlaylist[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([isPublic])
}

model ProblemInPlaylist {
  id         String   @id @default(uuid())
  playlistId String
  problemId  String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  problem  Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([playlistId, problemId])
  @@index([playlistId, order])
}

// ============================================
// DISCUSSION SYSTEM
// ============================================

model Discussion {
  id        String   @id @default(uuid())
  problemId String
  userId    String
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problem  Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]
  votes    DiscussionVote[]

  @@index([problemId])
  @@index([userId])
  @@index([createdAt])
}

model DiscussionComment {
  id           String   @id @default(uuid())
  discussionId String
  userId       String
  content      String   @db.Text
  upvotes      Int      @default(0)
  downvotes    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion    @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      CommentVote[]

  @@index([discussionId])
  @@index([userId])
}

model DiscussionVote {
  id           String   @id @default(uuid())
  discussionId String
  userId       String
  value        Int
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  comment DiscussionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

// ============================================
// RATING SYSTEM
// ============================================

model ProblemRating {
  id         String   @id @default(uuid())
  problemId  String
  userId     String
  rating     Int
  difficulty Int?
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([problemId])
}
