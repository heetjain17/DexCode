{
  "name": "@dexcode/backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "description": "DexCode Backend - A full-stack competitive programming platform with real-time code execution, judging, and social features.",
  "keywords": [
    "competitive-programming",
    "leetcode",
    "judge",
    "coding-platform",
    "online-judge",
    "express",
    "drizzle-orm",
    "postgresql"
  ],
  "author": {
    "name": "DexCode Contributors",
    "url": "https://github.com/heetjain17/DEXCODE"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heetjain17/DEXCODE.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/heetjain17/DEXCODE#readme",
  "bugs": {
    "url": "https://github.com/heetjain17/DEXCODE/issues"
  },
  "scripts": {
    "prepr": "npm run lint:fix && npm run format",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-beta": "tsx src/db/seed-beta.ts"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.29",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "pg": "^8.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
